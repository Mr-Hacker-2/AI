# Viora AI backend configuration
# Copy this file to .env and adjust as needed: cp .env.example .env

# Server
PORT=8000

# Paths (relative to project root)
CONVERSATIONS_FILE=conversations.json
TOOLS_PATH=tools.json
JOBS_FILE=task_jobs.json
LOCAL_DIR=./models
CAPTURES_DIR=captures

# Chat LLM (Qwen)
CHAT_REPO_ID=Qwen/Qwen3-0.6B-GGUF
CHAT_FILENAME=Qwen3-0.6B-Q8_0.gguf

# Tool LLM (Function Gemma)
TOOL_REPO_ID=nlouis/functiongemma-pocket-q4_k_m
TOOL_FILENAME=functiongemma-pocket-q4_k_m.gguf

# Logging (optional): DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
# LOG_FILE=


# Comma-separated trusted browser origins; do not use * with credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Required to use privileged endpoints such as alarm controls, surveillance start, and shutdown.
# Generate a long random value and send it as: Authorization: Bearer <token>
ADMIN_API_TOKEN=
